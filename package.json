{
  "name": "hidden-crown",
  "version": "2.3.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build && npm start",
    "dev:cloudflare": "wrangler dev",
    "build": "node scripts/build-server.mjs",
    "start": "node dist/server.mjs",
    "deploy": "wrangler deploy",
    "test": "node scripts/build-server.mjs && vitest run test/engine.test.ts test/board-motion.test.js test/replay.test.js test/rules.test.ts test/storage.test.ts test/computer.test.ts test/security.test.ts test/undo.test.ts test/turn-sound.test.js test/interrogation.test.ts test/game-records.test.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test:selfhost": "node scripts/selfhost-smoke.mjs",
    "test:room": "node scripts/room-smoke.mjs",
    "test:computer": "node scripts/computer-smoke.mjs",
    "test:capacity": "node scripts/capacity-smoke.mjs",
    "test:undo": "node scripts/undo-smoke.mjs",
    "test:interrogation": "node scripts/interrogation-smoke.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "ws": "^8.22.0"
  }
}
