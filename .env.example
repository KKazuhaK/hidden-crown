PUBLIC_ORIGIN=https://chess.example.com
ADMIN_USERNAME=admin
# Required: enter your own 16-256 character password; single quotes preserve literal $ signs.
ADMIN_PASSWORD=''
HOST_PORT=8787
# Set this to Nginx's exact peer address as seen by the container.
# Host Nginx usually connects from a Docker bridge gateway, e.g. 172.17.0.1.
# A wrong address remains safe but combines all users behind the proxy's IP limit.
TRUSTED_PROXIES=
HIDDEN_CROWN_IMAGE=ghcr.io/kkazuhak/hidden-crown:1.0.2
CREATE_LIMIT_PER_IP=5
CREATE_LIMIT_GLOBAL=50
WAITING_TIMEOUT_MINUTES=15
MAX_ROOMS=1000
MAX_CONNECTIONS=512
MAX_ROOM_BYTES=4194304
MAX_DATABASE_BYTES=268435456
