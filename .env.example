PUBLIC_ORIGIN=https://chess.example.com
ADMIN_USERNAME=admin
# Required: enter your own 16-256 character password; single quotes preserve literal $ signs.
ADMIN_PASSWORD=''
HOST_PORT=8787
# Set this to Nginx's exact peer address as seen by the container.
# Host Nginx usually connects from a Docker bridge gateway, e.g. 172.17.0.1.
# A wrong address remains safe but combines all users behind the proxy's IP limit.
TRUSTED_PROXIES=
HIDDEN_CROWN_IMAGE=ghcr.io/kkazuhak/hidden-crown:2.0.0
CREATE_LIMIT_PER_IP=5
CREATE_LIMIT_GLOBAL=100
WAITING_TIMEOUT_MINUTES=15
MAX_ROOMS=10000
MAX_CONNECTIONS=512
MAX_ROOM_BYTES=4194304
MAX_DATABASE_BYTES=1073741824

# Empty URL selects SQLite. Fill this to use an existing PostgreSQL (14+).
# Percent-encode reserved characters in URL usernames/passwords.
DATABASE_URL=
PG_POOL_MAX=10
MAX_ACTIVE_ROOMS=256
MAX_LOADED_ROOMS=256
MAX_CACHE_BYTES=67108864
MAX_STORED_BYTES=805306368
